# Copy to .env (or export) before starting the server.

# Trained model (built by training/train.py). Without it the server falls back to the heuristic aspects.
MODEL_PATH=models/detector.joblib

# Semantic layer: off | uncertain | always
#   uncertain = transcribe + judge only when the fast model is unsure (0.30 < p < 0.70)
SEMANTIC_MODE=off
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
CLAUDE_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...

# Optional SSL embedding head (needs torch + transformers and a model trained with --embeddings)
ENABLE_EMBEDDINGS=0
EMBEDDING_MODEL=microsoft/wavlm-base-plus

# Live call agent: Gemini writes the lines, ElevenLabs speaks them, faster-whisper hears the caller.
# GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# ELEVENLABS_API_KEY=...                (empty -> browser speech synthesis)
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_multilingual_v2
LIVE_WHISPER_MODEL=base
LIVE_ANSWER_TIMEOUT_S=9

# Sharing: share.ps1 / share.sh write the public tunnel URL to share_url.txt; or set it here
# SHARE_URL=https://xxxx.trycloudflare.com

# Dashboard convenience: list dataset calls in a dropdown
# SAMPLES_DIR=C:/Users/you/Downloads/altur-challenge-audio/audio
# SAMPLES_MANIFEST=C:/Users/you/Downloads/manifest.csv

# Decision + evidence
DECISION_THRESHOLD=0.5
MIN_SPEECH_SECONDS=1.5
FULL_CONFIDENCE_SPEECH_SECONDS=8
MAX_SECONDS=300
LIVE_UPDATE_INTERVAL_S=2
LOG_LEVEL=INFO
