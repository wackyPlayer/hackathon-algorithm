# Copy to .env (or export) before starting the server.

# Trained model (built by training/train.py). Without it the server falls back to the heuristic aspects.
MODEL_PATH=models/detector.joblib

# Semantic layer: off | uncertain | always
#   uncertain = transcribe + judge only when the fast model is unsure (0.30 < p < 0.70)
SEMANTIC_MODE=off
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
CLAUDE_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...

# Optional SSL embedding head (needs torch + transformers and a model trained with --embeddings)
ENABLE_EMBEDDINGS=0
EMBEDDING_MODEL=microsoft/wavlm-base-plus

# Dashboard convenience: list dataset calls in a dropdown
# SAMPLES_DIR=C:/Users/you/Downloads/altur-challenge-audio/audio
# SAMPLES_MANIFEST=C:/Users/you/Downloads/manifest.csv

# Decision + evidence
DECISION_THRESHOLD=0.5
MIN_SPEECH_SECONDS=1.5
FULL_CONFIDENCE_SPEECH_SECONDS=8
MAX_SECONDS=300
LIVE_UPDATE_INTERVAL_S=2
LOG_LEVEL=INFO
